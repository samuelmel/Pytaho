# Ambiente (development, staging, production)
# ==============================================================================
# Variáveis de Ambiente - Template (.env.example)
# Copie este arquivo para .env e preencha com suas configurações reais.
# NUNCA envie o arquivo .env para o repositório Git.
# ==============================================================================

# Ambiente de execução (development, staging, production)
ENVIRONMENT=development

# Conexões de Banco de Dados (Exemplo: PostgreSQL, SQL Server, MySQL)
# Conexão com o Banco de Dados de Origem (Source)
DB_SOURCE_HOST=localhost
DB_SOURCE_PORT=5432
DB_SOURCE_NAME=source_db
DB_SOURCE_USER=postgres
DB_SOURCE_PASSWORD=secret_password
DB_SOURCE_NAME=db_origem
DB_SOURCE_USER=usuario
DB_SOURCE_PASSWORD=senha

# Conexão com o Banco de Dados de Destino / Data Warehouse (Target)
DB_TARGET_HOST=localhost
DB_TARGET_PORT=5432
DB_TARGET_NAME=datawarehouse
DB_TARGET_USER=postgres
DB_TARGET_PASSWORD=secret_password
DB_TARGET_NAME=dw_destino
DB_TARGET_USER=usuario
DB_TARGET_PASSWORD=senha

# Alternativamente, Connection Strings completas (SQLAlchemy style):
# DB_SOURCE_URL=postgresql+psycopg://postgres:secret_password@localhost:5432/source_db
# DB_TARGET_URL=postgresql+psycopg://postgres:secret_password@localhost:5432/datawarehouse

# APIs Externas
EXTERNAL_API_BASE_URL=https://api.exemplo.com/v1
EXTERNAL_API_KEY=seu_token_aqui
EXTERNAL_API_KEY=sua_chave_de_api

# Notificações / Alertas (Slack, Teams, Discord, etc.)
# Webhooks de Notificação
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/xxx
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=seu_email@empresa.com
EMAIL_PASSWORD=sua_senha_de_app
EMAIL_ALERT_RECIPIENTS=engenharia-dados@empresa.com

